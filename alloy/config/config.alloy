// Grafana Alloy configuration for the VPS.
//
// Ships host syslog, the systemd journal, and Docker container logs to the
// central Loki on the homeserver (100.69.1.1) over the Netbird mesh.
//
// NOTE: on Ubuntu, /var/log/syslog and the systemd journal overlap heavily.
// Both sources are kept here per the rollout spec; trim one later if the
// duplicate volume in Loki is undesirable.

loki.source.file "syslog" {
    targets = [{
        __address__ = "localhost",
        __path__    = "/var/log/syslog",
        job         = "syslog",
        host        = "vps",
    }]
    forward_to = [loki.write.default.receiver]
}

loki.source.journal "systemd" {
    forward_to = [loki.write.default.receiver]
    labels     = { job = "systemd", host = "vps" }
}

discovery.docker "docker" {
    host             = "unix:///var/run/docker.sock"
    refresh_interval = "5s"
}

discovery.relabel "docker" {
    targets = []
    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container"
    }
    rule {
        source_labels = ["__meta_docker_compose_project"]
        target_label  = "compose_project"
    }
    rule {
        source_labels = ["__meta_docker_compose_service"]
        target_label  = "compose_service"
    }
}

loki.source.docker "docker" {
    host             = "unix:///var/run/docker.sock"
    targets          = discovery.docker.docker.targets
    forward_to       = [loki.write.default.receiver]
    relabel_rules    = discovery.relabel.docker.rules
    refresh_interval = "5s"
}

// CrowdSec alerts, one JSON object per line, written by its `file` notification
// plugin. Fields are extracted at query time with `| json` — keeping IP, scenario
// and country out of the labels, they would explode Loki's stream cardinality.
loki.source.file "crowdsec_alerts" {
    targets = [{
        __address__ = "localhost",
        __path__    = "/var/log/crowdsec/alerts.json",
        job         = "crowdsec-alerts",
        host        = "vps",
    }]
    forward_to = [loki.write.default.receiver]
}

loki.write "default" {
    endpoint {
        url = "http://100.69.1.1:3100/loki/api/v1/push"
    }
    external_labels = { host = "vps" }
}

// netbird-server metrics. Scraped over the docker network and pushed to the
// homeserver Prometheus rather than scraped by it: netbird-server cannot publish
// a port on 100.69.0.1, that address only exists once the mesh it serves is up.
prometheus.scrape "netbird" {
    targets = [{
        __address__ = "netbird-server:9090",
        job         = "netbird",
        instance    = "vps",
    }]
    forward_to      = [prometheus.remote_write.homeserver.receiver]
    scrape_interval = "30s"
}

prometheus.remote_write "homeserver" {
    endpoint {
        url = "http://100.69.1.1:9090/api/v1/write"
    }
    external_labels = { host = "vps" }
}
